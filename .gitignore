.venv/
.idea/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Secrets — never commit. Census API key lives here.
.env
.env.*
!.env.example

# Derived — rebuild with `python src/pipeline.py`
data/snap.duckdb
data/snap.duckdb.wal
data/raw/hist.csv

# The source zip is 23MB; keep it out of git and re-fetch when needed.
data/raw/*.zip

# Cached Census API pulls — re-fetch with the analysis scripts.
data/raw/*.json

# Standalone bundle (8.4MB) — rebuild with `python src/build_standalone.py`.
dist/

# Cached deck.gl runtime for the standalone build.
data/vendor/

# Map payload (11.6MB) — regenerate with `python src/export_map.py`.
# Commit deliberately only when deploying to GitHub Pages.
web/data/

# data/brands.csv is deliberately NOT ignored — it is hand-curated source.

# Analysis intermediates and generated report bundles — rebuild with
# src/analysis/post*.py then src/analysis/export_post*.py
reports/data/
reports/post*/
reports/post*.html
# Same: written by src/analysis/build_methodology.py, which is the source.
reports/methodology/
