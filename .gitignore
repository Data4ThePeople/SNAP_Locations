.venv/
.idea/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Secrets — never commit. Census API key lives here.
.env
.env.*
!.env.example

# Derived — rebuild with `python src/pipeline.py`
data/snap.duckdb
data/snap.duckdb.wal
data/raw/hist.csv

# The source zip is 23MB; keep it out of git and re-fetch when needed.
data/raw/*.zip

# Cached Census API pulls — re-fetch with the analysis scripts.
data/raw/*.json

# Build outputs. The standalone bundle is the exception: it is the artifact the
# visualisation is embedded from, so it is tracked deliberately. Rebuild it with
# `python src/build_standalone.py` and re-commit whenever web/ or the map data
# changes — a stale bundle is the failure mode, since it looks fine and silently
# serves an older map. It is ~8.5MB of gzip+base64 that git cannot delta-compress,
# so every rebuild adds roughly that much to history for good.
dist/*
!dist/snap-map.html

# Cached deck.gl runtime for the standalone build.
data/vendor/

# Map payload (11.6MB) — regenerate with `python src/export_map.py`.
# Commit deliberately only when deploying to GitHub Pages.
web/data/

# data/brands.csv is deliberately NOT ignored — it is hand-curated source.

# Analysis intermediates and generated report bundles — rebuild with
# src/analysis/post*.py then src/analysis/export_post*.py
reports/data/
reports/post*/
reports/post*.html
# Same: written by src/analysis/build_methodology.py, which is the source.
reports/methodology/
